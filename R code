# LDA topic modeling ----
library(topicmodels)
library(tm)
library(SnowballC)

#tokenize again with stemming this time - "travel" and "traveling" become the same word
custom_stops_lda <- tibble(word = c(
  "t.co", "https", "http", "amp", "instagram", "photo",
  "link", "bio", "check", "comment", "follow", "like",
  "post", "share", "tag", "video", "watch", "youtube",
  "gonna", "gotta", "gt", "lt"
))

words_lda <- df %>%
  select(post_url, caption_clean) %>%
  unnest_tokens(word, caption_clean) %>%
  anti_join(stop_words,     by = "word") %>%
  anti_join(custom_stops_lda, by = "word") %>%
  filter(!str_detect(word, "^[0-9]+$")) %>%
  filter(!str_detect(word, "^[^a-z]+$")) %>%
  filter(nchar(word) > 2) %>%
  mutate(word = wordStem(word, language = "en")) #stem: "traveling" -> "travel"

#build document term matrix - rows = posts, columns = words, values = word count
word_counts_lda <- words_lda %>%
  count(post_url, word, sort = TRUE) %>%
  group_by(word) %>%
  filter(n() >= 3) %>%  #only keep words that appear in at least 3 posts
  ungroup()

dtm <- word_counts_lda %>%
  cast_dtm(document = post_url, term = word, value = n)

cat("DTM size:", nrow(dtm), "posts x", ncol(dtm), "unique words\n")

#Q6: find optimal number of topics using perplexity
#
set.seed(42)
perplexity_scores <- tibble(k = integer(), perplexity = double())

for (k_test in 2:8) {
  cat("testing k =", k_test, "...\n")
  model_test <- LDA(dtm, k = k_test, method = "Gibbs",
                    control = list(seed = 42, burnin = 500, iter = 1000, thin = 1))
  perplexity_scores <- perplexity_scores %>%
    add_row(k = k_test, perplexity = perplexity(model_test, dtm))
}

print(perplexity_scores)

ggplot(perplexity_scores, aes(x = k, y = perplexity)) +
  geom_line(colour = "#2c7bb6", linewidth = 1.2) +
  geom_point(size = 3, colour = "#d7191c") +
  scale_x_continuous(breaks = 2:8) +
  labs(title = "LDA Perplexity by Number of Topics",
       subtitle = "look for the elbow - where it stops dropping fast",
       x = "k (number of topics)", y = "perplexity (lower = better)") +
  theme_minimal()

ggsave("plot_lda_perplexity.png", width = 7, height = 4)

