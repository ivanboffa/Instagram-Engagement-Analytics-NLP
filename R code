    "Topic 1: Van Life & Road Trips",
    "Topic 2: Outdoor Adventure & Hiking",
    "Topic 3: City & Cultural Travel",
    "Topic 4: Digital Nomad Lifestyle",
    "Topic 5: Country Visits & Personal Stories"
  )
)

#Q7: topic probabilities per post (gamma = how much each post belongs to each topic)
post_topics <- tidy(lda_model, matrix = "gamma")

#which topic is most dominant in each post
dominant_topic <- post_topics %>%
  group_by(document) %>%
  slice_max(gamma, n = 1) %>%
  ungroup() %>%
  rename(post_url = document, dominant_topic = topic, dominant_gamma = gamma)

#wide format so each topic probability is its own column
gamma_wide <- post_topics %>%
  pivot_wider(names_from = topic, values_from = gamma, names_prefix = "topic_prob_") %>%
  rename(post_url = document)

#merge back in
df <- df %>%
  left_join(gamma_wide,     by = "post_url") %>%
  left_join(dominant_topic, by = "post_url") %>%
  left_join(topic_names,    by = c("dominant_topic" = "topic"))

#save everything before the regression
write_csv(df, "df_with_all_features.csv")
cat("saved df_with_all_features.csv -", ncol(df), "columns now\n")


