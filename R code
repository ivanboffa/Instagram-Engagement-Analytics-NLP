#sentiment analysis with 3 lexicons ----
#first need to tokenize again, this time keeping post_url as the id
words_df_sentiment <- df %>%
  select(post_url, influencer_id, caption_clean) %>%
  unnest_tokens(word, caption_clean)

#lexicon 1: AFINN - scores each word from -5 (very bad) to +5 (very good)
afinn <- get_sentiments("afinn")

afinn_scores <- words_df_sentiment %>%
  inner_join(afinn, by = "word") %>%   #only keeps words that exist in afinn
  group_by(post_url) %>%
  summarise(
    afinn_sum    = sum(value),    #total score for the post
    afinn_mean   = mean(value),   #average score per word
    afinn_nwords = n()            #how many afinn words were found
  )

#lexicon 2: bing - simple positive or negative label per word
bing <- get_sentiments("bing")

bing_scores <- words_df_sentiment %>%
  inner_join(bing, by = "word") %>%
  group_by(post_url) %>%
  summarise(
    bing_positive = sum(sentiment == "positive"),
    bing_negative = sum(sentiment == "negative"),
    bing_net      = bing_positive - bing_negative,              #positive - negative
    bing_ratio    = bing_positive / (bing_positive + bing_negative + 0.001) #+0.001 to avoid dividing by zero
  )

#lexicon 3: NRC - 8 emotions (joy, anger, fear, trust etc.)
#also asks to download first time
nrc <- get_sentiments("nrc")

nrc_emotions <- nrc %>%
  filter(!sentiment %in% c("positive", "negative")) #only want the emotion labels not pos/neg

nrc_scores <- words_df_sentiment %>%
  inner_join(nrc_emotions, by = "word") %>%
  group_by(post_url, sentiment) %>%
  summarise(count = n(), .groups = "drop") %>%
  pivot_wider(names_from = sentiment, values_from = count,
              values_fill = 0, names_prefix = "nrc_")

#merge all three back into main dataframe
df <- df %>%
  left_join(afinn_scores, by = "post_url") %>%
  left_join(bing_scores,  by = "post_url") %>%
  left_join(nrc_scores,   by = "post_url")

