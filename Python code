"""
=============================================================================
INSTAGRAM SCRAPER & COMPUTER VISION FEATURE EXTRACTION
=============================================================================
This script performs web scraping using Selenium to extract post metadata 
and images, followed by Computer Vision feature extraction (Color Analysis 
via OpenCV and Object Detection via Hugging Face DETR).
"""

import os
import glob
import time
import re
import cv2
import numpy as np
import pandas as pd
import requests
from selenium import webdriver
from selenium.webdriver.common.keys import Keys
from selenium.webdriver.support import expected_conditions as EC
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.chrome.service import Service
from selenium.common.exceptions import TimeoutException
from webdriver_manager.chrome import ChromeDriverManager
import torch
from transformers import DetrForObjectDetection, DetrImageProcessor
from PIL import Image

# =============================================================================
# 1. INSTAGRAM DATA SCRAPING (SELENIUM)
# =============================================================================
def scrape_instagram_profiles(influencer_urls, posts_needed=50):
    options = webdriver.chrome.options.Options()
    options.add_argument("--start-maximized")  
    service = Service(ChromeDriverManager().install())
    driver = webdriver.Chrome(service=service, options=options)

    driver.get("https://www.instagram.com/")

    # Accept Cookies
    try:
        decline_cookies = WebDriverWait(driver, 15).until(
            EC.element_to_be_clickable((By.XPATH, "//button[contains(., 'Decline optional cookies')]"))
        )
        decline_cookies.click()
    except TimeoutException:
        pass

    # Login
    username = WebDriverWait(driver, 30).until(
        EC.presence_of_element_located((By.XPATH, "//input[@name='email' or contains(@aria-label, 'username')]"))
    )
    password = WebDriverWait(driver, 30).until(
        EC.presence_of_element_located((By.XPATH, "//input[@name='pass' or @aria-label='Password']"))
    )
    
    username.clear()
    password.clear()

    username.send_keys("xxx") 
    password.send_keys("xxx") 
    password.send_keys(Keys.RETURN)
    time.sleep(5)

    data = []
    save_dir = os.path.join(os.getcwd(), "scrapping_dmi")
    os.makedirs(save_dir, exist_ok=True)

    for influencer_url in influencer_urls:
        driver.get(influencer_url)
        time.sleep(5)
        
        influencer_name = influencer_url.rstrip("/").split("/")[-1]
        anchors = []
        stale_rounds = 0
        
        # Scroll and collect links
        for _ in range(200):
            before = len(anchors)
            anchor_elements = driver.find_elements(By.CSS_SELECTOR, "a[href*='/p/']")
            for elem in anchor_elements:
                href = elem.get_attribute("href")
                if href and href not in anchors:
                    anchors.append(href)
            
            if len(anchors) >= posts_needed:
                break
                
            driver.execute_script("window.scrollTo(0, document.body.scrollHeight);")
            time.sleep(3)
            
            if len(anchors) == before:
                stale_rounds += 1
                if stale_rounds >= 5:
                    break
            else:
                stale_rounds = 0

        anchors = anchors[:posts_needed]
        
        # Extract data for each post
        for index, a in enumerate(anchors):
            driver.get(a)
            time.sleep(5)
            
            # Get Metadata
            try:
                metadata_element = driver.find_element(By.XPATH, '//meta[@name="description"]')
                metadata = metadata_element.get_attribute('content')
            except:
                metadata = "Not found"
                
            # Download Image
            try:
                og_img = WebDriverWait(driver, 10).until(
                    EC.presence_of_element_located((By.CSS_SELECTOR, "meta[property='og:image']"))
                )
                image_url = og_img.get_attribute("content")
                image_name = f"{influencer_name}_image_{index}.jpg"
                image_save_as = os.path.join(save_dir, image_name)
                
                img_data = requests.get(image_url, timeout=20).content
                with open(image_save_as, "wb") as f:
                    f.write(img_data)
            except:
                image_url, image_name = "Not found", "Not found"

            data.append({
                'Influencer': influencer_name,
                'Post URL': a,
                'Image Name': image_name,
                'Metadata': metadata,
                'Image URL': image_url
            })

    driver.quit()
    df = pd.DataFrame(data)
    df.to_excel('scrapping_dmi.xlsx', index=False)
    return df

# =============================================================================
# 2. METADATA PARSING (PANDAS)
# =============================================================================
def parse_metadata(file_path="scrapping_dmi.xlsx"):
    df = pd.read_excel(file_path)
    
    def extract_likes(meta):
        if pd.isna(meta): return None
        m = re.search(r"([\d.,]+(?:\.\d+)?\s*[KM]?)\s+likes", meta, flags=re.IGNORECASE)
        if m:
            val = m.group(1).replace(" ", "").replace(",", "").upper()
            if 'K' in val: return float(val.replace('K','')) * 1000
            if 'M' in val: return float(val.replace('M','')) * 1000000
            return float(val)
        return None

    df["Number of Likes"] = df["Metadata"].apply(extract_likes)
    df.to_excel(file_path, index=False)
    print("Metadata parsing complete.")

# =============================================================================
# 3. COMPUTER VISION: COLOR ANALYSIS (OPENCV)
# =============================================================================
def color_photography(img_path):
    img = cv2.imread(img_path)
    if img is None: raise ValueError(f"Cannot load {img_path}")
    
    hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV).astype(float) / 255.0 
    hsv = cv2.resize(hsv, (256, 256))
    
    brightness = np.mean(hsv[:, :, 2])
    saturation = np.mean(hsv[:, :, 1])
    brightness_contrast = np.std(hsv[:, :, 2])
    warmth = np.sum((hsv[:, :, 0] < 30/360) | (hsv[:, :, 0] > 110/360)) / (256 * 256) 
    
    return brightness, saturation, brightness_contrast, warmth

def batch_color_analysis(folder_path='scrapping_dmi', output_excel='color_analysis_results.xlsx'):
    image_files = glob.glob(os.path.join(folder_path, '*.jpg'))
    results = []
    for img_file in image_files:
        try:
            b, s, bc, w = color_photography(img_file)
            results.append({
                'File Name': os.path.basename(img_file),
                'Brightness': b,
                'Saturation': s,
                'Brightness Contrast': bc,
                'Warmth': w
            })
        except Exception as e:
            print(e)
    pd.DataFrame(results).to_excel(os.path.join(folder_path, output_excel), index=False)

# =============================================================================
# 4. COMPUTER VISION: OBJECT DETECTION (HUGGING FACE DETR)
# =============================================================================
def batch_object_detection(folder_path='scrapping_dmi', output_excel='detr_results.xlsx'):
    model = DetrForObjectDetection.from_pretrained("facebook/detr-resnet-50")
    processor = DetrImageProcessor.from_pretrained("facebook/detr-resnet-50")
    config = model.config
    
    image_files = [f for f in os.listdir(folder_path) if f.lower().endswith(('.png', '.jpg'))]
    results = []
    
    for img_file in image_files:
        full_path = os.path.join(folder_path, img_file)
        image = Image.open(full_path).convert("RGB")
        inputs = processor(images=image, return_tensors="pt")
        outputs = model(**inputs)
        
        probas = outputs.logits.softmax(-1)[0, :, :-1]
        keep = probas.max(-1).values > 0.75
        labels = probas.max(-1).indices[keep]
        
        label_names = [config.id2label[label.item()] for label in labels]
        unique_objects = set(label_names)
        
        results.append({
            "File Name": img_file,
            "Total Detected Objects": len(label_names),
            "Number of Unique Objects": len(unique_objects),
            "All Label Names": ", ".join(label_names),
        })
        
    pd.DataFrame(results).to_excel(os.path.join(folder_path, output_excel), index=False)

if __name__ == "__main__":
    print("Script ready. Call functions to execute pipeline.")
