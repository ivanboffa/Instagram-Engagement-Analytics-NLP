# =============================================================================
# 1. INSTAGRAM DATA SCRAPING (SELENIUM)
# =============================================================================
def scrape_instagram_profiles(influencer_urls, posts_needed=50):
    options = webdriver.chrome.options.Options()
    options.add_argument("--start-maximized")  
    service = Service(ChromeDriverManager().install())
    driver = webdriver.Chrome(service=service, options=options)

    driver.get("https://www.instagram.com/")

    # Accept Cookies
    try:
        decline_cookies = WebDriverWait(driver, 15).until(
            EC.element_to_be_clickable((By.XPATH, "//button[normalize-space()='Decline optional cookies' or contains(., 'Decline optional cookies')]"))
        )
        decline_cookies.click()
    except TimeoutException:
        print("Cookie banner not shown (or selector changed).")

    # Login
    username = WebDriverWait(driver, 30).until(
        EC.presence_of_element_located((By.XPATH, "//input[@name='email' or contains(@aria-label, 'username')]"))
    )
    password = WebDriverWait(driver, 30).until(
        EC.presence_of_element_located((By.XPATH, "//input[@name='pass' or @aria-label='Password']"))
    )
    
    username.clear()
    password.clear()

    username.send_keys("xxx") 
    password.send_keys("xxx") 
    password.send_keys(Keys.RETURN)
    time.sleep(10)

    # Handle "Not Now" popups
    try: 
        not_now_button = WebDriverWait(driver, 20).until(
            EC.element_to_be_clickable((By.XPATH, '//div[@role="button" and text()="Not now"]')) 
        )
        not_now_button.click() 
    except TimeoutException: 
        pass

    try:
        not_now_button2 = WebDriverWait(driver, 20).until(
            EC.element_to_be_clickable((By.XPATH, '//button[text()="Not Now"]'))
        )
        not_now_button2.click()
    except TimeoutException:
        pass

    data = []
    save_dir = os.path.join(os.getcwd(), "scrapping_dmi")
    os.makedirs(save_dir, exist_ok=True)

    for influencer_url in influencer_urls:
        driver.get(influencer_url)
        time.sleep(5)
        
        influencer_name = influencer_url.rstrip("/").split("/")[-1]
        anchors = []
        stale_rounds = 0
        
        # Scroll and collect links
        for _ in range(200):
            before = len(anchors)
            anchor_elements = driver.find_elements(By.CSS_SELECTOR, "a[href*='/p/']")
            for elem in anchor_elements:
                href = elem.get_attribute("href")
                if href and href not in anchors:
                    anchors.append(href)
            
            if len(anchors) >= posts_needed:
                break
                
            driver.execute_script("window.scrollTo(0, document.body.scrollHeight);")
            time.sleep(3)
            
            if len(anchors) == before:
                stale_rounds += 1
                if stale_rounds >= 5:
                    print("No new posts loading after several scrolls (possible throttling).")
                    break
            else:
                stale_rounds = 0

        anchors = anchors[:posts_needed]
        print(f"Found {len(anchors)} links for {influencer_url}")
        
        # Extract data for each post
        for index, a in enumerate(anchors):
            driver.get(a)
            time.sleep(10)
            
            # Get Date and Time
            try:
                datetime_element = driver.find_element(By.XPATH, '//time[contains(@class, "x1p4m5qa")]') 
                date_time = datetime_element.get_attribute('datetime')
                if date_time:
                    date_time = date_time.replace('Z', '')
            except Exception:
                date_time = "Not found"

            # Get Metadata
            try:
                metadata_element = driver.find_element(By.XPATH, '//meta[@name="description"]')
                metadata = metadata_element.get_attribute('content')
            except Exception:
                metadata = "Not found"
                
            # Download Image via Open Graph
            try:
                og_img = WebDriverWait(driver, 10).until(
                    EC.presence_of_element_located((By.CSS_SELECTOR, "meta[property='og:image']"))
                )
                image_url = og_img.get_attribute("content")
                
                if any(row.get("Image URL") == image_url for row in data):
                    continue
                    
                image_name = f"{influencer_name}_image_{index}.jpg"
                image_save_as = os.path.join(save_dir, image_name)
                
                img_data = requests.get(image_url, timeout=20).content
                with open(image_save_as, "wb") as f:
                    f.write(img_data)
            except Exception as e:
                image_url, image_name = "Not found", "Not found"

            data.append({
                'Influencer': influencer_name,
                'Post URL': a,
                'Image Name': image_name,
                'Date Time': date_time,
                'Metadata': metadata,
                'Image URL': image_url
            })

    driver.quit()
    df = pd.DataFrame(data)
    df['Date Time'] = pd.to_datetime(df['Date Time'], errors='coerce').dt.tz_localize(None)
    df = df.sort_values(by='Date Time', ascending=False)
    df.to_excel('scrapping_dmi.xlsx', index=False)
    return df

# =============================================================================
# 2. METADATA PARSING (PANDAS)
# =============================================================================
def convert_to_number(value):
    if pd.isna(value) or not isinstance(value, str): return None
    value = value.replace(",", "").strip()
    if value.lower() == "not found": return None
    try:
        if "K" in value.upper(): return float(value.upper().replace("K", "")) * 1000
        elif "M" in value.upper(): return float(value.upper().replace("M", "")) * 1000000
        else: return float(value)
    except ValueError: return None

def get_likes_manual(metadata):
    if not isinstance(metadata, str): return None
    idx_likes = metadata.lower().find("likes")
    if idx_likes == -1: return None
    raw_likes = metadata[:idx_likes].strip()
    raw_likes = raw_likes.split()[-1] if raw_likes.split() else raw_likes
    return convert_to_number(raw_likes)

def get_comments_manual(metadata):
    if not isinstance(metadata, str): return None
    idx_comma = metadata.find(',')
    if idx_comma == -1: return None
    idx_comments = metadata.lower().find("comments", idx_comma + 1)
    if idx_comments == -1: return None
    raw_substring = metadata[idx_comma + 1: idx_comments].strip().upper().replace(",", "")
    multiplier = 1
    if 'K' in raw_substring:
        multiplier = 1000
        raw_substring = raw_substring.replace('K', '')
    elif 'M' in raw_substring:
        multiplier = 1000000
        raw_substring = raw_substring.replace('M', '')
    try: return int(float(raw_substring.strip()) * multiplier)
    except ValueError: return None

def get_caption_manual(metadata):
    if not isinstance(metadata, str): return None
    start_idx = metadata.find(': "')
    if start_idx == -1: return None
    start_quote = start_idx + len(': "')
    end_quote = metadata.find('"', start_quote)
    if end_quote == -1: return None
    return metadata[start_quote:end_quote].strip()

def parse_metadata(file_path="scrapping_dmi.xlsx"):
    df = pd.read_excel(file_path)
    
    def extract_all(x):
        return pd.Series([get_likes_manual(x), get_comments_manual(x), get_caption_manual(x)])

    df[["Number of Likes", "Number of Comments", "Caption"]] = df["Metadata"].apply(extract_all)
    df["Number of Comments"] = df["Number of Comments"].astype('float', errors='ignore')
    
    df.to_excel(file_path, index=False)
    print("Metadata parsing complete. Likes, Comments, and Captions extracted.")

# =============================================================================
# 3. COMPUTER VISION: COLOR ANALYSIS (OPENCV)
# =============================================================================
def color_photography(img_path):
    img = cv2.imread(img_path)
    if img is None: raise ValueError(f"Cannot load {img_path}")
    
    hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV).astype(float) / 255.0 
    hsv = cv2.resize(hsv, (256, 256))
    
    brightness = np.mean(hsv[:, :, 2])
    saturation = np.mean(hsv[:, :, 1])
    brightness_contrast = np.std(hsv[:, :, 2])
    warmth = np.sum((hsv[:, :, 0] < 30/360) | (hsv[:, :, 0] > 110/360)) / (256 * 256) 
    
    return brightness, saturation, brightness_contrast, warmth

def batch_color_analysis(folder_path='scrapping_dmi', output_excel='color_analysis_results.xlsx'):
    image_files = glob.glob(os.path.join(folder_path, '*.jpg'))
    results = []
    for img_file in image_files:
        try:
            b, s, bc, w = color_photography(img_file)
            results.append({
                'File Name': os.path.basename(img_file),
                'Brightness': b,
                'Saturation': s,
                'Brightness Contrast': bc,
                'Warmth': w
            })
        except Exception as e:
            print(e)
    
    pd.DataFrame(results).to_excel(os.path.join(folder_path, output_excel), index=False)
    print(f"Color analysis saved to: {output_excel}")

# =============================================================================
# 4. COMPUTER VISION: OBJECT DETECTION (HUGGING FACE DETR)
# =============================================================================
def batch_object_detection(folder_path='scrapping_dmi', output_excel='detr_object_detection_results.xlsx'):
    model = DetrForObjectDetection.from_pretrained("facebook/detr-resnet-50")
    processor = DetrImageProcessor.from_pretrained("facebook/detr-resnet-50")
    config = model.config
    
    image_files = [f for f in os.listdir(folder_path) if f.lower().endswith(('.png', '.jpg', '.jpeg'))]
    results = []
    
    for img_file in image_files:
        full_path = os.path.join(folder_path, img_file)
        image = Image.open(full_path).convert("RGB")
        inputs = processor(images=image, return_tensors="pt")
        outputs = model(**inputs)
        
        probas = outputs.logits.softmax(-1)[0, :, :-1]
        keep = probas.max(-1).values >= 0.75
        labels = probas.max(-1).indices[keep]
        
        label_names = [config.id2label[label.item()] for label in labels]
        unique_objects = set(label_names)
        
        results.append({
            "File Name": img_file,
            "Total Detected Objects": len(label_names),
            "Number of Unique Objects": len(unique_objects),
            "All Label Names": ", ".join(label_names),
            "Unique Label Names": ", ".join(unique_objects)
        })
        
    pd.DataFrame(results).to_excel(os.path.join(folder_path, output_excel), index=False)
    print(f"Object detection results saved to: {output_excel}")

